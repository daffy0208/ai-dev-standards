{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-dev-standards/schemas/orchestration-result.json",
  "title": "Orchestration Result",
  "description": "Schema for Claude Code orchestration results written after execution",
  "type": "object",
  "required": ["request_id", "status", "timestamp", "execution_time_ms"],
  "properties": {
    "request_id": {
      "type": "string",
      "description": "ID of the originating request",
      "pattern": "^\\d{13}$"
    },
    "status": {
      "type": "string",
      "description": "Execution status",
      "enum": ["success", "partial_success", "failed"]
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of result creation",
      "format": "date-time"
    },
    "execution_time_ms": {
      "type": "number",
      "description": "Time taken to execute in milliseconds"
    },
    "result_type": {
      "type": "string",
      "description": "Type of result produced",
      "enum": [
        "execution_plan",
        "validation_report",
        "diagnostic_report",
        "manifest",
        "capability_graph",
        "analysis_report"
      ]
    },
    "data": {
      "type": "object",
      "description": "Result data (structure varies by result_type)",
      "properties": {
        "plan": {
          "type": "object",
          "description": "Execution plan for orchestration_plan requests",
          "properties": {
            "goal": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "skill": { "type": "string" },
                  "description": { "type": "string" },
                  "dependencies": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "estimated_duration": { "type": "string" },
                  "risk_level": { "type": "string" }
                }
              }
            },
            "estimated_total_time": { "type": "string" },
            "complexity_score": { "type": "number" },
            "confidence_level": { "type": "string" }
          }
        },
        "validation": {
          "type": "object",
          "description": "Validation results for validate requests",
          "properties": {
            "is_valid": { "type": "boolean" },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": { "type": "string" },
                  "message": { "type": "string" },
                  "location": { "type": "string" }
                }
              }
            },
            "suggestions": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "diagnostics": {
          "type": "object",
          "description": "Project diagnostics for diagnose requests",
          "properties": {
            "health_score": { "type": "number" },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "category": { "type": "string" },
                  "severity": { "type": "string" },
                  "description": { "type": "string" },
                  "recommendation": { "type": "string" }
                }
              }
            },
            "strengths": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "manifest": {
          "type": "object",
          "description": "Generated manifest for generate_manifest requests"
        },
        "capability_graph": {
          "type": "object",
          "description": "Capability graph for build_capability_graph requests"
        },
        "analysis": {
          "type": "object",
          "description": "Project analysis for analyze_project requests"
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Execution metrics",
      "properties": {
        "tokens_used": {
          "type": "number",
          "description": "Approximate tokens used by Claude Code"
        },
        "files_read": {
          "type": "number"
        },
        "files_analyzed": {
          "type": "number"
        }
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Next steps or recommendations",
      "items": {
        "type": "object",
        "properties": {
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "action": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "description": "Errors encountered during execution",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": "object" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "description": "Warnings encountered during execution",
      "items": {
        "type": "string"
      }
    }
  }
}
