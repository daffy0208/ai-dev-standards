{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "react", "vitest"]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".archive",
    "html",
    "TOOLS",
    "MCP-SERVERS",
    "INTEGRATIONS",
    "COMPONENTS"
  ]
}
