{
  "version": "1.0.0",
  "last_updated": "2025-11-14",
  "description": "Registry of tool files for MCP servers using the Code Execution pattern. Tool files are discovered progressively through file navigation and executed in a sandboxed environment.",
  "total_servers": 0,
  "total_tools": 0,
  "servers": [],
  "schema": {
    "server": {
      "id": "string - MCP server ID (must match mcp-registry.json)",
      "server_path": "string - Path to server directory (e.g., /mcp-servers/semantic-search-mcp/servers/semantic-search)",
      "skills_path": "string - Path to skills directory (e.g., /mcp-servers/semantic-search-mcp/skills)",
      "readme_path": "string - Path to server README",
      "tool_list_path": "string - Path to tool_list.txt",
      "tools": [
        {
          "name": "string - Tool function name (snake_case)",
          "file_path": "string - Relative path to tool file",
          "category": "string - Tool category",
          "description": "string - Tool description",
          "input_schema": "object - JSON schema for input",
          "output_schema": "object - JSON schema for output",
          "complexity_score": "number - Complexity score 1-10",
          "estimated_tokens": "number - Estimated tokens for tool definition",
          "last_updated": "string - ISO date"
        }
      ],
      "skills_count": "number - Number of persistent skills",
      "pattern_version": "string - Code Execution pattern version",
      "security_layers": "array - Enabled security layers",
      "migration_date": "string - ISO date when migrated to Code Execution",
      "metrics": {
        "total_executions": "number",
        "average_token_usage": "number",
        "skill_reuse_rate": "number - Percentage",
        "error_rate": "number - Percentage"
      }
    }
  },
  "migration_tracking": {
    "description": "Tracks MCPs migrated from Direct to Code Execution pattern",
    "pilot_mcp": "semantic-search-mcp",
    "pilot_status": "not-started",
    "tier_1_completed": [],
    "tier_2_completed": [],
    "total_migrated": 0,
    "migration_timeline": []
  },
  "statistics": {
    "total_tool_files": 0,
    "total_skills_generated": 0,
    "average_tools_per_server": 0,
    "average_skills_per_server": 0,
    "most_used_server": null,
    "most_reused_skill": null,
    "total_token_savings": {
      "first_run_savings_percent": 0,
      "with_skills_savings_percent": 0,
      "total_tokens_saved": 0
    }
  },
  "notes": [
    "This registry is automatically updated when MCPs are migrated to Code Execution pattern",
    "Tool files are discovered at runtime through progressive discovery",
    "Skills are generated by the agent and persist in the skills directory",
    "Metrics are collected during execution and updated periodically",
